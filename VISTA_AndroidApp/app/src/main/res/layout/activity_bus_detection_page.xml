<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/main"
android:layout_width="match_parent"
android:layout_height="match_parent"
tools:context=".BusDetectionPage"
android:background="@color/white">

<!-- 攝像頭預覽 -->
<SurfaceView
    android:id="@+id/cameraSurfaceView"
    android:layout_width="match_parent"
    android:layout_height="300dp"
    app:layout_constraintTop_toTopOf="parent" />

<!-- 顯示檢測後的圖像 -->
<ImageView
    android:id="@+id/detectedImageView"
    android:layout_width="match_parent"
    android:layout_height="300dp"
    android:scaleType="fitCenter"
    app:layout_constraintTop_toTopOf="parent" />

<!-- 顯示到站時間 -->
<TextView
    android:id="@+id/tv_current_stop"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text="Route: --, Stop: --"
    android:textSize="16sp"
    android:layout_marginTop="8dp"
    app:layout_constraintTop_toBottomOf="@id/detectedImageView"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

<ListView
    android:id="@+id/lv_arrival_times"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_marginTop="4dp"
    app:layout_constraintTop_toBottomOf="@id/tv_current_stop"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>