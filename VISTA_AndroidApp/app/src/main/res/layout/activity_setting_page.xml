<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:weightSum="5">

    <!-- Main Menu text -->
    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/white"
        android:text="@string/SettingActivity_Setting"
        android:textSize="50sp"
        android:textStyle="bold" />

    <!-- Language Setting Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLanSetting"
        style="@style/SemiTransparentRoundedButton"
        android:layout_width="357dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:text="@string/SettingActivity_LanguageSetting"
        android:textSize="22sp" />

    <!-- Voice Setting Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVoiceSetting"
        style="@style/SemiTransparentRoundedButton"
        android:layout_width="361dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:text="@string/SettingActivity_VoiceSetting"
        android:textSize="22sp" />

    <!-- Empty Button 1 (Retained as requested) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn"
        style="@style/SemiTransparentRoundedButton"
        android:layout_width="357dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:text=""
        android:textSize="22sp" />

    <!-- Empty Button 2 (Retained as requested) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button5"
        style="@style/SemiTransparentRoundedButton"
        android:layout_width="361dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:text=""
        android:textSize="22sp" />

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:layout_marginTop="16dp"
        android:weightSum="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditRouteActivityConfirm"
            style="@style/SemiTransparentRoundedButton"
            android:layout_width="0dp"
            android:layout_height="83dp"
            android:layout_weight="1"
            android:text="@string/btn_Confirm"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditRouteActivityNext"
            style="@style/SemiTransparentRoundedButton"
            android:layout_width="0dp"
            android:layout_height="83dp"
            android:layout_weight="1"
            android:text="@string/btn_next"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>