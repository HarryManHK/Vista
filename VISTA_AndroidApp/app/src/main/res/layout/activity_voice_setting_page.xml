<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="15dp"
    >

    <!-- Wrapper Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:gravity="center">

    <!-- Header Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:layout_gravity="center"
                android:text="@string/VoiceSettingPage_title"
                android:textSize="50sp"
                android:textStyle="bold"
                android:textColor="#3BA7C9" />
        </LinearLayout>

        <!-- Top Buttons Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLanSetting"
                style="@style/SemiTransparentRoundedButton"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_margin="16dp"
            android:layout_gravity="center"

            android:background="@drawable/btn_photo_gradient"
                android:text="@string/VoiceSettingPage_VoiceLanguageSetting"
                android:textSize="22sp"
                app:backgroundTint="@null"
                app:backgroundTintMode="src_over"
                app:cornerRadius="0dp"
                app:strokeColor="@null"
                app:strokeWidth="0dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoiceSpeedSetting"
                style="@style/SemiTransparentRoundedButton"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_margin="16dp"
                android:layout_gravity="center"

                android:background="@drawable/btn_photo_gradient"
                android:text="@string/VoiceSettingPage_VoiceSpeedSetting"
                android:textSize="22sp"
                app:backgroundTint="@null"
                app:backgroundTintMode="src_over"
                app:cornerRadius="0dp"
                app:strokeColor="@null"
                app:strokeWidth="0dp" />
        </LinearLayout>

        <!-- Bottom Buttons Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGender"
                style="@style/SemiTransparentRoundedButton"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_margin="16dp"
                android:layout_gravity="center"

                android:background="@drawable/btn_photo_gradient"
                android:text="@string/VoiceSettingPage_VoiceGenderSetting"
                android:textSize="22sp"
                app:backgroundTint="@null"
                app:backgroundTintMode="src_over"
                app:cornerRadius="0dp"
                app:strokeColor="@null"
                app:strokeWidth="0dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button5"
                style="@style/SemiTransparentRoundedButton"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_margin="16dp"
                android:layout_gravity="center"
                android:background="@drawable/btn_photo_gradient"
                android:text=""
                android:textSize="22sp"
                app:backgroundTint="@null"
                app:backgroundTintMode="src_over"
                app:cornerRadius="0dp"
                app:strokeColor="@null"
                app:strokeWidth="0dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>