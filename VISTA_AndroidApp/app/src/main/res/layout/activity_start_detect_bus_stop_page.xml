<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".StartDetectBusStopPage"
    android:background="@color/white">

    <!-- 攝像頭預覽 -->
    <SurfaceView
        android:id="@+id/cameraSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 顯示檢測後的圖像 -->
    <ImageView
        android:id="@+id/detectedImageView"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_bus_detect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_bus_detect"
        app:layout_constraintTop_toBottomOf="@id/detectedImageView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="22sp"
        android:textStyle="bold"
        android:background="@drawable/btn_photo_gradient"
        app:backgroundTint="@null"
        app:backgroundTintMode="src_over"
        app:cornerRadius="0dp"
        app:strokeColor="@null"
        app:strokeWidth="0dp"
        android:layout_marginTop="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>