<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="vertical"
    android:weightSum="5">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="175dp"
        android:layout_height="73dp"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:src="@drawable/vista_logo" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="4dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/MainMenuPageActivity_title"
        android:textColor="#3BA7C9"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- Buttons Container (to group buttons with equal height) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:gravity="center"
        android:orientation="vertical"
        android:weightSum="5">

        <!-- Find Bus Stop Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button5"
            android:layout_width="361dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:background="@drawable/btn_photo_gradient"
            android:text="@string/MainMenuPageActivity_FindBusStop"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            app:backgroundTint="@null"
            app:backgroundTintMode="src_over"
            app:cornerRadius="0dp"
            app:strokeColor="@null"
            app:strokeWidth="0dp" />

        <!-- Image to Text Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMainMenuImgToTxt"
            android:layout_width="357dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:background="@drawable/btn_photo_gradient"
            android:text="@string/MainMenuPageActivity_ImageToText"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            app:backgroundTint="@null"
            app:backgroundTintMode="src_over"
            app:cornerRadius="0dp"
            app:strokeColor="@null"
            app:strokeWidth="0dp" />

        <!-- Setting Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMainMenuSetting"
            android:layout_width="354dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:background="@drawable/btn_photo_gradient"
            android:text="@string/MainMenuPageActivity_Setting"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            app:backgroundTint="@null"
            app:backgroundTintMode="src_over"
            app:cornerRadius="0dp"
            app:strokeColor="@null"
            app:strokeWidth="0dp" />

        <!-- Empty Button (Placeholder) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMainMenuChatbot"
            android:layout_width="355dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:background="@drawable/btn_photo_gradient"
            android:text="Chat Bot"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            app:backgroundTint="@null"
            app:backgroundTintMode="src_over"
            app:cornerRadius="0dp"
            app:strokeColor="@null"
            app:strokeWidth="0dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoiceControl"
            android:layout_width="355dp"
            android:layout_height="0dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:background="@drawable/btn_photo_gradient"
            android:text="Voice Control"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            app:backgroundTint="@null"
            app:backgroundTintMode="src_over"
            app:cornerRadius="0dp"
            app:strokeColor="@null"
            app:strokeWidth="0dp" />

    </LinearLayout>
</LinearLayout>
