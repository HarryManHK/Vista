<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="15dp"
    >
    <!-- Wrapper Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:gravity="center">
        <!-- Header Container -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMainMenuSetting"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="16dp"
            android:layout_gravity="end"
            android:background="@drawable/button_setting"
            android:onClick="openSettingPage"
            android:contentDescription="@string/setting"
            app:backgroundTint="@null"
            app:backgroundTintMode="src_over"
            app:cornerRadius="0dp"
            app:strokeColor="@null"
            app:strokeWidth="0dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:text="@string/imageToTextMenu_title"
                android:textSize="50sp"
                android:textStyle="bold"
                android:textColor="#3BA7C9" />
        </LinearLayout>
        <!-- Top Buttons Container -->
        <LinearLayout
            android:layout_width="356dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:orientation="horizontal"
            android:gravity="center">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectImageDetect"
                style="@style/SemiTransparentRoundedButton"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/imageToTextMenu_SelectImageDetect"
                android:textSize="22sp"
                android:background="@drawable/btn_photo_gradient"
                app:backgroundTint="@null"
                app:backgroundTintMode="src_over"
                app:cornerRadius="0dp"
                app:strokeColor="@null"
                app:strokeWidth="0dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoRealTimeDetectPage"
                style="@style/SemiTransparentRoundedButton"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/imageToTextMenu_RealTimeDetect"
                android:textSize="22sp"
                android:background="@drawable/btn_photo_gradient"
                app:backgroundTint="@null"
                app:backgroundTintMode="src_over"
                app:cornerRadius="0dp"
                app:strokeColor="@null"
                app:strokeWidth="0dp" />
        </LinearLayout>
        <!-- Bottom Buttons Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTakePhotoDetect"
                style="@style/SemiTransparentRoundedButton"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginBottom="16dp"
                android:text="@string/imageToTextMenu_TakePhotoDetect"
                android:textSize="22sp"
                android:background="@drawable/btn_photo_gradient"
                app:backgroundTint="@null"
                app:backgroundTintMode="src_over"
                app:cornerRadius="0dp"
                app:strokeColor="@null"
                app:strokeWidth="0dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>