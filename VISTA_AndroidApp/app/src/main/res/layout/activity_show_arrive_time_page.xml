<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16sp"
    tools:context=".ShowArriveTimePage"
    android:background="@color/white">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/showArriveTimePage_title"
        android:id="@+id/txtshowArriveTimePage_title"
        android:textColor="#3BA7C9"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/showArriveTimePage_currentBusStop"
        android:textSize="18sp"
        android:textStyle="bold"
        android:id="@+id/txtShowArriveTimePageCurrentBusStop"
        android:textColor="#3BA7C9"/>

    <ListView
        android:id="@+id/lvShowArriveTimePage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/list_item_border"
        android:divider="@drawable/custom_divider"
        android:textColor="#3BA7C9"/>

</LinearLayout>